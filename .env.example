# ─────────────────────────────────────────────────────────────────
#  Gympify Mobile BFF — Environment Variables
#  Copy this file to .env and fill in the values.
#  NEVER commit your .env file to source control.
# ─────────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development          # development | production | test

# ── Database (Central MySQL) ──────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_DATABASE=coderstm_gympify

# ── JWT Authentication ────────────────────────────────────────────
# Must be at least 32 random characters in production.
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRATION=24h            # Access token lifetime (e.g. 1h, 24h, 7d)

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (besides localhost).
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,https://yourdomain.com

# ── Tenant Resolution ─────────────────────────────────────────────
# Comma-separated list of central domain names (used for subdomain extraction).
CENTRAL_DOMAINS=yourvps.example.com,localhost,127.0.0.1

# ── Email (Password Reset) ────────────────────────────────────────
# Required in production to actually send reset emails.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM="Gympify <noreply@example.com>"
